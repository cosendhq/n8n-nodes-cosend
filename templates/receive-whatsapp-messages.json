          "reason": "The message matched no keyword"
        }
      },
      "id": "7a2e4d10-1b3c-4e5f-8a6b-1c2d3e4f5a08",
      "name": "Pass to my team",
      "type": "n8n-nodes-cosend.cosend",
      "typeVersion": 1,
