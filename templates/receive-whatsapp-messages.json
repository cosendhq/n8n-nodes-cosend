      "id": "7a2e4d10-1b3c-4e5f-8a6b-1c2d3e4f50c1",
      "name": "Who is answering",
      "type": "n8n-nodes-cosend.cosend",
      "typeVersion": 1,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
